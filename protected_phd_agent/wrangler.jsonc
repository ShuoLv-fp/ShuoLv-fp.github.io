{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shuo-phd-agent",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "kv_namespaces": [
    {
      "binding": "PHD_AGENT_DATA",
      "id": "cccf0bd2bfe04081a177f57242e15b7e"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKFLOW_COORDINATOR",
        "class_name": "WorkflowCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkflowCoordinator"]
    }
  ]
}
